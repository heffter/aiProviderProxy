{
  "name": "aiproviderproxy",
  "version": "2.1.0",
  "private": true,
  "description": "Local multi-protocol AI gateway (aipp): Anthropic Messages and OpenAI Chat Completions across providers, with routing, redaction, and usage export.",
  "repository": {
    "type": "git",
    "url": "https://github.com/heffter/aiProviderProxy"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "aipp": "dist/cli/aipp.js",
    "aiproviderproxy": "dist/cli/aipp.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "start": "node dist/cli.js",
    "test": "tsc && vitest run",
    "test:watch": "vitest",
    "harness:v1.7": "bash ./scripts/v1.7-harness.sh",
    "prepublishOnly": "npm run build",
    "test:integration": "vitest run __tests__/integration/",
    "test:e2e": "vitest run test/e2e/",
    "test:parity": "vitest run test/fixtures test/parity",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"src/{gateway,protocols,providers,models,lifecycle,routing,integrations,ops,config,cli,tools,fixtures,runtime}/**/*.ts\" src/identity.ts \"test/**/*.ts\"",
    "format:check": "prettier --check \"src/{gateway,protocols,providers,models,lifecycle,routing,integrations,ops,config,cli,tools,fixtures,runtime}/**/*.ts\" src/identity.ts \"test/**/*.ts\"",
    "typecheck": "tsc -p tsconfig.gates.json",
    "test:gates": "vitest run --config vitest.gates.config.ts --coverage",
    "gates": "npm run lint && npm run typecheck && npm run test:gates"
  },
  "keywords": [
    "relayplane",
    "ai",
    "llm",
    "proxy",
    "routing",
    "anthropic",
    "openai",
    "gemini",
    "openclaw",
    "observability",
    "agent-ops"
  ],
  "author": "RelayPlane",
  "license": "MIT",
  "dependencies": {
    "better-sqlite3": "^11.10.0",
    "js-yaml": "^4.1.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/js-yaml": "^4.0.9",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^9.1.2",
    "prettier": "^3.9.6",
    "typescript": "^5.3.3",
    "typescript-eslint": "^8.65.0",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=18"
  },
  "files": [
    "dist",
    "assets",
    "README.md"
  ]
}
